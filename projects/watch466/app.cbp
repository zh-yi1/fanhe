<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="app" />
		<Option pch_mode="2" />
		<Option compiler="riscv32-v3" />
		<Build>
			<Target title="Debug">
				<Option output="Output/bin/app.rv32" prefix_auto="1" extension_auto="0" />
				<Option object_output="Output/obj/" />
				<Option type="1" />
				<Option compiler="riscv32-v3" />
				<Linker>
					<Add library="../../platform/libs/libm.a" />
					<Add library="../../platform/libs/libgcc.a" />
					<Add library="../../platform/libs/libc.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Os" />
			<Add option="-Wall" />
			<Add option="-march=rv32imc_zba_zbb_zbc_zbs_zca_zcb_zcmp_zfinx_xbs1" />
			<Add option="--param=min-pagesize=0" />
			<Add option="-Wno-address-of-packed-member" />
			<Add option="-ffunction-sections" />
			<Add option="-mjump-tables-in-text" />
			<Add directory="." />
			<Add directory="functions" />
			<Add directory="port" />
			<Add directory="i18n" />
			<Add directory="plugin" />
			<Add directory="../../platform/header" />
			<Add directory="../../platform/libs" />
			<Add directory="../../platform/bsp" />
			<Add directory="../../platform/bsp/bsp_app" />
			<Add directory="../../platform/bsp/bsp_bt" />
			<Add directory="../../platform/bsp/bsp_ble" />
			<Add directory="../../platform/bsp/bsp_sensor" />
			<Add directory="../../platform/bsp/bsp_music" />
			<Add directory="../../platform/bsp/bsp_effect" />
			<Add directory="../../platform/gui" />
			<Add directory="../../platform/gui/rotate_disp" />
			<Add directory="../../platform/gui/components" />
			<Add directory="../../platform/gui/tft" />
			<Add directory="../../platform/gui/ctp" />
			<Add directory="../../platform/gui/lcd" />
			<Add directory="../../platform/gui/ctp/axs5106" />
			<Add directory="functions/common" />
			<Add directory="../../platform/libs/libfixmath" />
			<Add directory="../../platform/libs/net/include" />
			<Add directory="../../platform/libs/net/include/lwip" />
			<Add directory="../../platform/libs/net/include/lwip/ports" />
			<Add directory="../../platform/bsp/bsp_fs" />
			<Add directory="../../platform/bsp/bsp_record" />
		</Compiler>
		<Linker>
			<Add option="-T$(TARGET_OBJECT_DIR)ram.o" />
			<Add option="--gc-sections" />
			<Add option="--no-warn-rwx-segments" />
			<Add option="-Map=Output\bin\map.txt" />
			<Add library="libplatform" />
			<Add library="libbtstack" />
			<Add library="libdrivers_v2" />
			<Add library="libgui" />
			<Add library="../../platform/bsp/bsp_sensor/hx3605/libhx3605.a" />
			<Add library="../../platform/bsp/bsp_sensor/hrs3300/libhrs3300.a" />
			<Add library="../../platform/bsp/bsp_sensor/hrs3300/libhrs3300_s.a" />
			<Add library="../../platform/bsp/bsp_sensor/hrs3300/libhrs3300_test.a" />
			<Add library="../../platform/bsp/bsp_sensor/sc7a20/libsc7a20.a" />
			<Add library="../../platform/libs/libm.a" />
			<Add library="../../platform/libs/libgcc.a" />
			<Add library="../../platform/libs/libc.a" />
			<Add library="../../platform/bsp/bsp_sensor/qmc6309/lib_qst_ical.a" />
			<Add directory="../../platform/libs" />
			<Add directory="../../platform/libs/net" />
		</Linker>
		<ExtraCommands>
			<Add before="Output\bin\prebuild.bat $(PROJECT_NAME)" />
			<Add after="Output\bin\postbuild.bat $(PROJECT_NAME)" />
			<Add after="Output\bin\postbuild_ble_ota.bat $(PROJECT_NAME)" />
